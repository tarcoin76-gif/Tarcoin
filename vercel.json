{
  "version": 2,
  "builds": [
    { "src": "api/*.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/status", "dest": "/api/blockchain.py" },
    { "src": "/api/wallet/create", "dest": "/api/blockchain.py" },
    { "src": "/api/telegram-webhook", "dest": "/api/bot.py" },
    { "src": "/(.*)", "dest": "/api/blockchain.py" }
  ]
}
