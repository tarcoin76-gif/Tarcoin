use cosmwasm_std::{
    entry_point, DepsMut, Env, MessageInfo, Response, StdResult, Uint128,
};
use cw20_base::contract::{execute as cw20_execute, instantiate as cw20_instantiate, query as cw20_query};
use cw20_base::state::{MinterData, TOKEN_INFO};
use cw20::{Cw20Coin, Logo, MarketingInfoResponse};

#[entry_point]
pub fn instantiate(
    deps: DepsMut,
    env: Env,
    info: MessageInfo,
    mut msg: cw20_base::msg::InstantiateMsg,
) -> StdResult<Response> {
    // Set specific parameters for TARCOIN
    msg.name = "TARCOIN".to_string();
    msg.symbol = "TRC".to_string();
    msg.decimals = 18;
    
    // Supply of 17,000,000 with 18 decimals (17,000,000 * 10^18)
    let total_supply = Uint128::from(17_000_000u128)
        .checked_mul(Uint128::from(10u128).pow(18))
        .unwrap();

    msg.initial_balances = vec![Cw20Coin {
        address: info.sender.to_string(),
        amount: total_supply,
    }];

    // Disable the mint function (None) to keep the supply permanently scarce
    msg.mint = None;

    cw20_instantiate(deps, env, info, msg)
}

#[entry_point]
pub fn execute(
    deps: DepsMut,
    env: Env,
    info: MessageInfo,
    msg: cw20_base::msg::ExecuteMsg,
) -> StdResult<Response> {
    cw20_execute(deps, env, info, msg)
}

#[entry_point]
pub fn query(
    deps: cosmwasm_std::Deps,
    env: Env,
    msg: cw20_base::msg::QueryMsg,
) -> StdResult<cosmwasm_std::Binary> {
    cw20_query(deps, env, msg)
}
